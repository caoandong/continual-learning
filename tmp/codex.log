+
+def get_model_device_map(model: AutoModelForCausalLM) -> dict[str, str]:
+    raw_map = getattr(model, "hf_device_map", None)
+    if isinstance(raw_map, dict):
+        normalized: dict[str, str] = {}
+        for name, placement in raw_map.items():
