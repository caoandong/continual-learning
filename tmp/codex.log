    'learning-without-training.pdf': ['theorem b.2', 'skip', 'rank-1', 'bias', 'stack of transformer blocks'],
    'transmuting-prompts-into-weights.pdf': ['theorem 3.1', 'algorithm 1', 'gemma', 'table 1', 'least-squares', 'appendix a'],
    'equivalence-of-context-and-parameter-updates.pdf': ['gemma', 'rmsnorm', 'scale', 'gating', 'modern transformer', 'algorithm', 'input controllability', 'output controllability'],
}
for path, needles in queries.items():
    text = '\\n'.join(page.extract_text() or '' for page in PdfReader(path).pages)
    lower = text.lower()
    print(f'FILE: {path}')
    for needle in needles:
        idx = lower.find(needle)
        print(f'NEEDLE: {needle} IDX: {idx}')
        if idx >= 0:
            start = max(0, idx - 500)
            end = min(len(text), idx + 1800)
            snippet = text[start:end].replace('\\x00', ' ')
            print(snippet)
            print('---')
    print('END_FILE')
